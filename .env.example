POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=app

JWT_SECRET=change-me
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me
FIRST_SUPERUSER_USERNAME=admin

# Assistant (ai-orchestrator)
REFERENCE_DATE=2026-08-05
LLAMA_MODEL=gpt-oss:20b-cloud
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Manuals RAG (MCP server): name of its own database on the shared Postgres
RAG_DB=rag

# LangSmith tracing for the assistant (opt-in). Traces include the questions, tool results and answers,
# so only enable it for a project whose members may see that data.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=ai-orchestrator
